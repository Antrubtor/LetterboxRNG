{
  "manifest_version": 3,
  "name": "Letterboxd Watchlist Picker",
  "version": "1.2.1",
  "description": "Random movie picker for Letterboxd watchlists and interactive diary statistics with a GitHub-style activity heatmap.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Letterboxd Watchlist Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://letterboxd.com/*",
    "*://*.letterboxd.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://letterboxd.com/*",
        "*://www.letterboxd.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
