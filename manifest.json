{
  "manifest_version": 3,
  "name": "Letterboxd Companion",
  "version": "1.7.0",
  "description": "Random film picker for watchlists & lists, diary & film stats with watch time, follow check and taste compatibility for Letterboxd.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Letterboxd Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://letterboxd.com/*",
    "*://*.letterboxd.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://letterboxd.com/*",
        "*://www.letterboxd.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "letterboxd-companion@antrubtor",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/Antrubtor/LetterboxCompanion/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
